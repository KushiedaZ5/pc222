@model PlataformaCreditos.Models.ViewModels.CrearSolicitudViewModel
@{
    ViewData["Title"] = "Registrar Solicitud de Crédito";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0"><i class="bi bi-file-earmark-plus text-primary me-2"></i>Nueva Solicitud de Crédito</h2>
            <a asp-action="MisSolicitudes" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver a mis solicitudes
            </a>
        </div>

        <!-- Feedback de Éxito / Error en la misma vista (Pregunta 3) -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <strong>@ViewBag.SuccessMessage</strong>
                @if (ViewBag.RabbitMqSuccess != null)
                {
                    <div class="mt-2 small text-success">
                        <i class="bi bi-send-check me-1"></i> @ViewBag.RabbitMqSuccess
                    </div>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <!-- Advertencia de falla de publicación en RabbitMQ (Pregunta 7: conservar solicitud y advertir error) -->
        @if (ViewBag.RabbitMqWarning != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <strong>Aviso de Mensajería:</strong> @ViewBag.RabbitMqWarning
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <!-- Errores de validación server-side -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger shadow-sm pb-1" role="alert">
                <h6 class="alert-heading fw-bold mb-2">
                    <i class="bi bi-x-octagon-fill me-1"></i> Errores de validación en el servidor:
                </h6>
                <div asp-validation-summary="All" class="text-danger small mb-0"></div>
            </div>
        }

        <!-- Tarjeta Informativa de Capacidad Financiera -->
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body">
                <h6 class="card-title fw-bold text-secondary mb-3">
                    <i class="bi bi-calculator me-1"></i> Capacidad Financiera del Cliente
                </h6>
                <div class="row text-center">
                    <div class="col-md-6 border-end">
                        <div class="text-muted small">Ingresos Mensuales</div>
                        <div class="fs-5 fw-bold text-success">@Model.IngresosMensuales.ToString("C")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Monto Máximo Permitido (10x Ingresos)</div>
                        <div class="fs-5 fw-bold text-primary">@Model.CapacidadMaxima.ToString("C")</div>
                    </div>
                </div>
                @if (!Model.ClienteActivo)
                {
                    <div class="alert alert-danger mt-3 mb-0 small">
                        <i class="bi bi-shield-lock-fill me-1"></i> Su cuenta está marcada como <strong>Inactiva</strong>. No podrá solicitar créditos.
                    </div>
                }
                @if (Model.TienePendiente)
                {
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <i class="bi bi-clock-history me-1"></i> Ya posee una solicitud en estado <strong>Pendiente</strong>. La regla de negocio estipula sólo una solicitud activa por cliente.
                    </div>
                }
            </div>
        </div>

        <!-- Formulario de Registro -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold">Ingrese los datos del crédito</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="MontoSolicitado" class="form-label fw-bold"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">$</span>
                            <input asp-for="MontoSolicitado" type="number" step="0.01" min="1" 
                                   max="@Model.CapacidadMaxima" class="form-control" 
                                   placeholder="Ej: 5000.00" 
                                   disabled="@(Model.TienePendiente || !Model.ClienteActivo)" />
                        </div>
                        <span asp-validation-for="MontoSolicitado" class="text-danger small"></span>
                        <div class="form-text">
                            El monto no puede ser negativo ni exceder 10 veces sus ingresos mensuales (@Model.CapacidadMaxima.ToString("C")).
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm"
                                disabled="@(Model.TienePendiente || !Model.ClienteActivo)">
                            <i class="bi bi-send-fill me-2"></i> Enviar Solicitud de Crédito
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
