@model PlataformaCreditos.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Detalle de Solicitud #{Model.Id}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="MisSolicitudes" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver a mis solicitudes
            </a>
            <!-- Estado de conexión WebSocket en vivo -->
            <span id="wsStatusBadgeDetalle" class="badge bg-secondary p-2 shadow-sm">
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                WebSocket: Conectando...
            </span>
        </div>

        <div class="card shadow border-0" id="cardDetalle">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h4 class="mb-0">
                    <i class="bi bi-file-earmark-text me-2"></i>Solicitud de Crédito #@Model.Id
                </h4>
                <span id="badgeEstadoDetalle" class="badge @(Model.Estado == "Aprobado" ? "bg-success" : (Model.Estado == "Rechazado" ? "bg-danger" : "bg-warning text-dark")) fs-6 px-3 py-2">
                    @Model.Estado
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-bold">Monto Solicitado</label>
                        <div class="fs-3 fw-bold text-primary">@Model.MontoSolicitado.ToString("C")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-bold">Fecha de Registro</label>
                        <div class="fs-5 text-dark">
                            <i class="bi bi-calendar-event me-1"></i>
                            @Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm:ss") (UTC)
                        </div>
                    </div>
                    <hr class="my-2">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-bold">Identificador del Cliente</label>
                        <div class="fs-6">Cliente #@Model.ClienteId</div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-bold">Ingresos Mensuales Registrados</label>
                        <div class="fs-6 fw-semibold text-success">
                            @(Model.Cliente?.IngresosMensuales.ToString("C") ?? "N/A")
                        </div>
                    </div>

                    <!-- Sección de Motivo de Rechazo (si aplica o se actualiza en vivo) -->
                    <div class="col-12" id="seccionMotivoRechazo" style="@(string.IsNullOrWhiteSpace(Model.MotivoRechazo) ? "display: none;" : "")">
                        <div class="alert alert-danger mb-0">
                            <h6 class="alert-heading fw-bold mb-1">
                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Motivo del Rechazo:
                            </h6>
                            <p class="mb-0" id="textoMotivoRechazo">@Model.MotivoRechazo</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light text-muted small d-flex justify-content-between">
                <span>Esta solicitud está registrada en SQLite y respaldada para evaluación de riesgo.</span>
                <span>ID Sistema: @Model.Id</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const solicitudActualId = @Model.Id;

        // SignalR WebSocket Hub (Pregunta 6)
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/solicitudes", {
                transport: signalR.HttpTransportType.WebSockets
            })
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        const badgeWs = document.getElementById("wsStatusBadgeDetalle");
        function setWsStatus(status, bgClass, icon) {
            if (!badgeWs) return;
            badgeWs.className = `badge ${bgClass} p-2 shadow-sm`;
            badgeWs.innerHTML = `<i class="bi ${icon} me-1"></i> WebSocket: ${status}`;
        }

        async function start() {
            try {
                await connection.start();
                setWsStatus("Conectado", "bg-success", "bi-check-circle-fill");
            } catch (err) {
                console.error("Error al conectar WebSocket:", err);
                setWsStatus("Desconectado", "bg-danger", "bi-x-circle-fill");
                setTimeout(start, 5000);
            }
        }

        // Reconexión y sincronización de estado (Pregunta 6)
        connection.onreconnecting(() => setWsStatus("Reconectando...", "bg-warning text-dark", "bi-arrow-repeat"));

        connection.onreconnected(async () => {
            setWsStatus("Conectado", "bg-success", "bi-check-circle-fill");
            try {
                const resp = await fetch(`/Solicitudes/ObtenerEstado?id=${solicitudActualId}`);
                if (resp.ok) {
                    const data = await resp.json();
                    actualizarDetalle(data.id, data.estado, data.motivoRechazo);
                }
            } catch (e) {
                console.error("Error al consultar estado tras reconexión:", e);
            }
        });

        connection.onclose(() => setWsStatus("Desconectado", "bg-danger", "bi-x-circle-fill"));

        // Evento recibido en tiempo real
        connection.on("SolicitudEstadoActualizado", (data) => {
            if (data.solicitudId === solicitudActualId) {
                actualizarDetalle(data.solicitudId, data.estado, data.motivoRechazo);

                const toastEl = document.getElementById("liveToast");
                const bodyEl = document.getElementById("liveToastBody");
                if (toastEl && bodyEl) {
                    bodyEl.innerHTML = `<strong>¡Estado Actualizado en Vivo!</strong><br>La solicitud ahora está: <span class="badge ${data.estado === 'Aprobado' ? 'bg-success' : 'bg-danger'}">${data.estado}</span>`;
                    new bootstrap.Toast(toastEl).show();
                }
            }
        });

        function actualizarDetalle(id, estado, motivo) {
            const badge = document.getElementById("badgeEstadoDetalle");
            if (badge) {
                badge.textContent = estado;
                badge.className = "badge fs-6 px-3 py-2 " +
                    (estado === "Aprobado" ? "bg-success" : (estado === "Rechazado" ? "bg-danger" : "bg-warning text-dark"));
            }

            const seccionMotivo = document.getElementById("seccionMotivoRechazo");
            const textoMotivo = document.getElementById("textoMotivoRechazo");
            if (seccionMotivo && textoMotivo) {
                if (estado === "Rechazado" && motivo) {
                    textoMotivo.textContent = motivo;
                    seccionMotivo.style.display = "block";
                } else {
                    seccionMotivo.style.display = "none";
                }
            }

            // Efecto visual
            const card = document.getElementById("cardDetalle");
            if (card) {
                card.classList.add("border-success");
                setTimeout(() => card.classList.remove("border-success"), 3000);
            }
        }

        start();
    </script>
}
